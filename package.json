{
  "name": "rti2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:cloudflare",
    "build:cloudflare": "npm install --no-save --package-lock=false @opennextjs/cloudflare@1.20.6 wrangler@4.142.0 && next build && npx opennextjs-cloudflare build --skipNextBuild",
    "deploy:cloudflare": "npm run production:preflight && npx opennextjs-cloudflare deploy",
    "build:next": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "test": "node --test tests/*.test.js",
    "watch-sync": "node watch-sync.js",
    "preview:cloudflare": "npx opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "d1:create": "npx wrangler d1 create rti-production --binding RTI_DB --update-config",
    "d1:migrate": "npx wrangler d1 migrations apply rti-production --remote",
    "d1:info": "npx wrangler d1 info rti-production",
    "eval:estimator": "node scripts/run-estimator-ai-evals.mjs",
    "eval:estimator:live": "RUN_LIVE_AI_EVALS=true node scripts/run-estimator-ai-evals.mjs",
    "production:preflight": "node scripts/check-estimator-production.mjs",
    "r2:create": "npx wrangler r2 bucket create rti-files-production",
    "deploy:cloudflare:production": "npm run production:preflight && npm run d1:migrate && npm run build:cloudflare && npx opennextjs-cloudflare deploy",
    "db:status:node": "node scripts/db-migrate.mjs status",
    "db:migrate:node": "node scripts/db-migrate.mjs up",
    "db:verify:node": "node scripts/db-migrate.mjs verify",
    "backup:node": "node scripts/backup.mjs",
    "restore:node": "node scripts/restore.mjs",
    "deploy:node": "node scripts/deploy-node.mjs",
    "production:preflight:node": "node scripts/check-node-production.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
