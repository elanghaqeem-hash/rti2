# ==============================================================================
# PT Riset Teknologi Indonesia (Risetin / RTI)
# Production & Local Environment Configuration
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://risetin.co.id

# ------------------------------------------------------------------------------
# Risetin Assistant - Multi-AI Failover
# Primary + multiple backup providers. The first configured provider that responds
# successfully will answer the visitor. API keys MUST remain server-side secrets.
# Default order: Anthropic -> OpenAI -> Gemini -> Groq -> OpenRouter -> DeepSeek -> Mistral -> xAI
# ------------------------------------------------------------------------------
AI_PROVIDER_ORDER=anthropic,openai,gemini,groq,openrouter,deepseek,mistral,xai
AI_PROVIDER_TIMEOUT_MS=8000

# Primary AI - Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Backup AI 1 - OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Backup AI 2 - Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Backup AI 3 - Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Backup AI 4 - OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Backup AI 5 - DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Backup AI 6 - Mistral AI
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Backup AI 7 - xAI (Grok)
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Embeddings & Vector Search (RAG)
VOYAGE_API_KEY=

# Database & Storage (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/risetin_db

# Rate Limiting & Bot Protection (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anti-Bot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email Dispatcher (Resend / SMTP)
RESEND_API_KEY=

# Cal.com Booking Integration
CAL_API_KEY=
NEXT_PUBLIC_CAL_LINK=risetin/30min

# Observability & Monitoring (Sentry)
SENTRY_DSN=


# ------------------------------------------------------------------------------
# Super Admin Control Plane
# Store all values below as deployment secrets. Never commit real credentials.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@risetin.co.id
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SETTINGS_ENCRYPTION_KEY=

# Encrypted CMS/API/SMTP persistence (Cloudflare KV via scoped API token)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=

# SMTP runtime configuration
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Risetin
SMTP_FROM_EMAIL=admin@risetin.co.id
SMTP_REPLY_TO=admin@risetin.co.id
