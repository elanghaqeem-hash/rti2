# ==============================================================================
# PT Riset Teknologi Indonesia (Risetin / RTI)
# Production & Local Environment Configuration
# ==============================================================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://risetin.co.id

# AI & LLM (Anthropic Claude API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Embeddings & Vector Search (RAG)
VOYAGE_API_KEY=

# Database & Storage (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/risetin_db

# Rate Limiting & Bot Protection (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anti-Bot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email Dispatcher (Resend / SMTP)
RESEND_API_KEY=

# Cal.com Booking Integration
CAL_API_KEY=
NEXT_PUBLIC_CAL_LINK=risetin/30min

# Observability & Monitoring (Sentry)
SENTRY_DSN=
