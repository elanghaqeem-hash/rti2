# ==============================================================================
# PT Riset Teknologi Indonesia (Risetin / RTI)
# Production Server Environment
# ==============================================================================
# Keep real values only in the target server secret/environment manager.
# Never commit production credentials.

# Public application URL
NEXT_PUBLIC_SITE_URL=https://risetin.co.id

# ------------------------------------------------------------------------------
# REQUIRED: Admin authentication
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate a cryptographically-random value (recommended >= 32 bytes).
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# REQUIRED database runtime
# ------------------------------------------------------------------------------
# Standard Node production server:
# Absolute writable path on the production server.
# Example: /var/lib/risetin/rti.sqlite
RTI_DB_PATH=

# Cloudflare Workers:
# Do NOT put a D1 database ID in this env file.
# Bind a Cloudflare D1 database to the Worker with variable name: RTI_DB
# The binding is a Cloudflare resource binding, not a string environment secret.

# ------------------------------------------------------------------------------
# REQUIRED for secure public forms / rate-limit identity hashing
# ------------------------------------------------------------------------------
RATE_LIMIT_SALT=

# ------------------------------------------------------------------------------
# Risetin Assistant - configure at least one provider for external AI
# ------------------------------------------------------------------------------
AI_PROVIDER_ORDER=anthropic,openai,gemini,deepseek,groq,openrouter
AI_PROVIDER_TIMEOUT_MS=8000

ANTHROPIC_API_KEY=
# Estimator Copilot model selection (do not hard-code in application code).
AI_MODEL_PRIMARY=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
# Legacy/general assistant fallback model.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional embeddings / RAG
VOYAGE_API_KEY=

# ------------------------------------------------------------------------------
# Optional rate limiting
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# Optional Cloudflare Turnstile
# The site key is public; TURNSTILE_SECRET_KEY remains server-side.
# These values belong on the production origin server even if Cloudflare
# only provides DNS/proxy/WAF.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# Optional outbound email
# ------------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender identity used for RFQ/customer notifications, e.g. RTI <noreply@risetin.co.id>
RTI_NOTIFICATION_FROM_EMAIL=

# Optional Cal.com API integration
CAL_API_KEY=
NEXT_PUBLIC_CAL_LINK=risetin/30min

# Optional monitoring
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Future/optional external PostgreSQL or pgvector workload.
# Current operational lead + parameter registry uses RTI_DB_PATH (SQLite).
# ------------------------------------------------------------------------------
DATABASE_URL=


# ------------------------------------------------------------------------------
# Project Estimator & RFQ supporting documents
# ------------------------------------------------------------------------------
# Store uploads outside the public web root. Production uploads remain disabled
# until storage and malware scanning are explicitly configured.
RTI_FILE_UPLOADS_ENABLED=false
RTI_UPLOAD_DIR=
RTI_FILE_UPLOAD_MAX_BYTES=10485760
RTI_MALWARE_SCAN_URL=
RTI_MALWARE_SCAN_TOKEN=
