{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rti2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,

  // Cloudflare/OpenNext staging configuration.
  // Production may still target the standard Node.js deployment path.
  // The OpenNext build generates .open-next/worker.js before Wrangler deploys.
  //
  // Runtime database on Workers: Cloudflare D1 binding RTI_DB.
  // Create it once with: npm run d1:create
  // Wrangler will append the d1_databases block with the real database_id.
  // Apply schema/config with: npm run d1:migrate

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },

  "d1_databases": [
    {
      "binding": "RTI_DB",
      "database_name": "rti-production",
      "migrations_dir": "migrations"
    }
  ],

  // Private Project Estimator document/RFQ storage.
  // Create before production deploy:
  //   npx wrangler r2 bucket create rti-files-production
  "r2_buckets": [
    {
      "binding": "RTI_FILES",
      "bucket_name": "rti-files-production"
    }
  ],

  "observability": {
    "enabled": true
  }
}
