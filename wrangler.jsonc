{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rti2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Cloudflare/OpenNext staging configuration.
  // Production may still target the standard Node.js deployment path.
  // The OpenNext build generates .open-next/worker.js before Wrangler deploys.

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
