# ==============================================================================
# RTI / Risetin production environment - COPY to .env.production and fill values
# Never commit the real .env.production file.
# ==============================================================================
NEXT_PUBLIC_SITE_URL=https://risetin.co.id
RTI_DB_PATH=/var/lib/risetin/rti.sqlite

# REQUIRED - Admin
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# REQUIRED - request/rate-limit identity hashing
RATE_LIMIT_SALT=

# AI - configure at least one external provider if AI assistance is required
AI_PROVIDER_ORDER=anthropic,openai,gemini,groq,openrouter
AI_PROVIDER_TIMEOUT_MS=8000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

VOYAGE_API_KEY=

# Optional public-form protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional email / booking / monitoring
RESEND_API_KEY=
CAL_API_KEY=
NEXT_PUBLIC_CAL_LINK=risetin/30min
SENTRY_DSN=

# Optional distributed rate-limit store
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reserved for future external PostgreSQL workloads.
DATABASE_URL=
