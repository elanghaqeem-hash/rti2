# ==============================================================================
# RTI / Risetin - Universal Production Deployment Profile
# Copy to .env.production on the target host and fill real values there.
# Never commit real production credentials.
# ==============================================================================

NODE_ENV=production
HOSTNAME=0.0.0.0
PORT=3000

# Public URL. NEXT_PUBLIC_* values are baked into the Next.js client bundle
# during build, so provide them before npm run build:next / docker build.
NEXT_PUBLIC_SITE_URL=https://risetin.co.id
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CAL_LINK=risetin/30min

# ------------------------------------------------------------------------------
# Application identity / release metadata (optional)
# ------------------------------------------------------------------------------
RTI_APP_VERSION=1.0.0
GIT_COMMIT_SHA=

# ------------------------------------------------------------------------------
# REQUIRED - administration and session security
# ------------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
RATE_LIMIT_SALT=

# ------------------------------------------------------------------------------
# Database - standard Node / Docker profile
# ------------------------------------------------------------------------------
# SQLite database must be on persistent storage.
RTI_DB_PATH=/var/lib/risetin/rti.sqlite
RTI_RUN_MIGRATIONS_ON_START=true

# Cloudflare alternative:
# Bind D1 as RTI_DB in wrangler.jsonc instead of setting RTI_DB_PATH.

# ------------------------------------------------------------------------------
# Private object storage
# ------------------------------------------------------------------------------
# auto = R2 binding on Cloudflare, filesystem on standard Node.
RTI_STORAGE_DRIVER=auto
RTI_FILE_UPLOADS_ENABLED=false
RTI_UPLOAD_DIR=/var/lib/risetin/uploads
RTI_FILE_UPLOAD_MAX_BYTES=10485760
RTI_MALWARE_SCAN_URL=
RTI_MALWARE_SCAN_TOKEN=

# Cloudflare alternative:
# Bind private R2 bucket as RTI_FILES in wrangler.jsonc.

# ------------------------------------------------------------------------------
# Backup / restore
# ------------------------------------------------------------------------------
RTI_BACKUP_DIR=/var/backups/risetin
RTI_BACKUP_INCLUDE_UPLOADS=true
RTI_BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# AI providers - configure only providers approved for production use
# ------------------------------------------------------------------------------
AI_PROVIDER_ORDER=anthropic,openai,gemini,deepseek,groq,openrouter
AI_PROVIDER_TIMEOUT_MS=8000

ANTHROPIC_API_KEY=
AI_MODEL_PRIMARY=claude-sonnet-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

VOYAGE_API_KEY=

# Privacy gate. Keep false until RTI explicitly approves external AI processing
# for raw documents.
RTI_AI_DOCUMENT_EXTERNAL_EXTRACTION_ENABLED=false

# ------------------------------------------------------------------------------
# Optional infrastructure
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
RTI_NOTIFICATION_FROM_EMAIL=
CAL_API_KEY=
SENTRY_DSN=

# Reserved for future PostgreSQL/pgvector workloads.
DATABASE_URL=
